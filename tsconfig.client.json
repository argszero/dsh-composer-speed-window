{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "declarationDir": "lib/types",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [],
    "emitDeclarationOnly": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
